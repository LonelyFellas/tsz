{
  "name": "tsz",
  "version": "1.0.0",
  "private": true,
  "description": "天生会背 — 词汇学习平台 (师生合一 + 平台后台)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check:node": "node scripts/check-node-runtime.mjs",
    "preinstall": "node scripts/check-node-runtime.mjs",
    "dev": "turbo run dev --filter=@tsz/web",
    "dev:admin": "turbo run dev --filter=@tsz/admin",
    "dev:admin:test": "pnpm --filter @tsz/admin dev:test",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node-runtime": "node --test scripts/node-runtime-version.test.mjs",
    "test:coverage-lock": "node --test scripts/coverage-lock.test.mjs",
    "test:deploy-provenance": "node --test deploy/provenance.test.mjs && bash deploy/deploy-source.test.sh && bash deploy/deploy-smoke.test.sh",
    "test:cov": "pnpm check:node && pnpm test:node-runtime && pnpm test:coverage-lock && pnpm test:deploy-provenance && node scripts/run-coverage-locked.mjs",
    "test:e2e": "pnpm --filter @tsz/e2e test:e2e",
    "test:e2e:admin": "pnpm --filter @tsz/e2e test:e2e:admin",
    "prepare": "lefthook install || true"
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": "10.33.0"
  },
  "volta": {
    "node": "24.19.0",
    "pnpm": "10.33.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tsz/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
