# 浏览器可见的 API 基址(务必只放公开信息)。默认走同源 /api/v1，由下面的代理转发。
VITE_API_BASE_URL=/api/v1

# dev 代理目标(仅本地开发用，含 /api/v1 前缀)。复制此文件为 .env.local 后按需改：
#   - 本地后端： http://localhost:8383/api/v1
#   - 测试线：   https://<test-host>/api/v1
# 改动后需重启 dev server 生效。
BACKEND_API_URL=http://localhost:8383/api/v1

# 语音富文本编辑器。未设置时 dev 默认开启、生产默认关闭；
# 测试服按需显式开启，这里显式关闭以对齐测试服现状。
VITE_VOICE_EDITOR=false

# 真实试听入口(调用 /admin/speech/previews)。默认关闭，须显式开启：
# 编辑器可先开，真实试听要等 /admin/speech/previews 真实合成冒烟通过后再开。
# 本地已配好语音凭据、要联调真实合成时，把这里改成 true。
VITE_VOICE_PREVIEW=false

# TTS mock。开启后试听走本地假适配器：不发任何请求、返回静音音频，
# 试听结果不是真实合成，仅用于后端未配置语音凭据时调 UI；
# 开启时界面会显示「模拟」标记。默认关闭(走真实 TTS)，生产构建禁止开启。
VITE_ADMIN_TTS_MOCK=false

# 词条语法、词义与例句的 AI 自动生成/回填。需求确认前保持关闭。
VITE_WORD_CONTENT_COMPLETION=false
