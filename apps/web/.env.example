# 后端 API 基地址(浏览器可见,务必只放公开信息)
NEXT_PUBLIC_API_BASE_URL=/api/v1
# 默认对接本地 tsz-rust(cargo run,8383);连测试服 tsz-go 旧后端时改回 8080 隧道
BACKEND_API_URL=http://localhost:8383/api/v1

# 站点对外规范地址(SEO):用于 canonical / sitemap / Open Graph / 图标的绝对基地址。
# 生产部署务必改成真实域名,例如 https://www.tianshenghuibei.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
